D3D12_STATE_OBJECT_FLAGS :: enum_flags u32 {
    NONE                                                     :: 0x0;
    ALLOW_LOCAL_DEPENDENCIES_ON_EXTERNAL_DEFINITIONS         :: 0x1;
    ALLOW_EXTERNAL_DEPENDENCIES_ON_LOCAL_DEFINITIONS         :: 0x2;
    ALLOW_STATE_OBJECT_ADDITIONS                             :: 0x4;
    WORK_GRAPHS_USE_GRAPHICS_STATE_FOR_GLOBAL_ROOT_SIGNATURE :: 0x40;
    FULL_SPECIALIZATION                                      :: 0x8;
    DEBUG_BREAK_ALWAYS_HALT                                  :: 0x80;
    DEBUG_BREAK_FORCE_NOP                                    :: 0x100;
    PREFER_MINIMAL_LINK                                      :: 0x200;
    PREFER_MINIMAL_LINK_BACKGROUND_SPECIALIZE                :: 0x400;

    D3D12_STATE_OBJECT_FLAG_NONE                                                     :: NONE;
    D3D12_STATE_OBJECT_FLAG_ALLOW_LOCAL_DEPENDENCIES_ON_EXTERNAL_DEFINITIONS         :: ALLOW_LOCAL_DEPENDENCIES_ON_EXTERNAL_DEFINITIONS;
    D3D12_STATE_OBJECT_FLAG_ALLOW_EXTERNAL_DEPENDENCIES_ON_LOCAL_DEFINITIONS         :: ALLOW_EXTERNAL_DEPENDENCIES_ON_LOCAL_DEFINITIONS;
    D3D12_STATE_OBJECT_FLAG_ALLOW_STATE_OBJECT_ADDITIONS                             :: ALLOW_STATE_OBJECT_ADDITIONS;
    D3D12_STATE_OBJECT_FLAG_WORK_GRAPHS_USE_GRAPHICS_STATE_FOR_GLOBAL_ROOT_SIGNATURE :: WORK_GRAPHS_USE_GRAPHICS_STATE_FOR_GLOBAL_ROOT_SIGNATURE;
    D3D12_STATE_OBJECT_FLAG_FULL_SPECIALIZATION                                      :: FULL_SPECIALIZATION;
    D3D12_STATE_OBJECT_FLAG_DEBUG_BREAK_ALWAYS_HALT                                  :: DEBUG_BREAK_ALWAYS_HALT;
    D3D12_STATE_OBJECT_FLAG_DEBUG_BREAK_FORCE_NOP                                    :: DEBUG_BREAK_FORCE_NOP;
    D3D12_STATE_OBJECT_FLAG_PREFER_MINIMAL_LINK                                      :: PREFER_MINIMAL_LINK;
    D3D12_STATE_OBJECT_FLAG_PREFER_MINIMAL_LINK_BACKGROUND_SPECIALIZE                :: PREFER_MINIMAL_LINK_BACKGROUND_SPECIALIZE;
}

