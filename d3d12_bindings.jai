    FULLY_UNKNOWN_TRANSPARENT :: -3;
    FULLY_UNKNOWN_OPAQUE      :: -4;

    D3D12_RAYTRACING_OPACITY_MICROMAP_SPECIAL_INDEX_FULLY_TRANSPARENT         :: FULLY_TRANSPARENT;
    D3D12_RAYTRACING_OPACITY_MICROMAP_SPECIAL_INDEX_FULLY_OPAQUE              :: FULLY_OPAQUE;
