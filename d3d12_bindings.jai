    TRANSPARENT         :: 0;
    OPAQUE              :: 1;
    UNKNOWN_TRANSPARENT :: 2;
    UNKNOWN_OPAQUE      :: 3;

    D3D12_RAYTRACING_OPACITY_MICROMAP_STATE_TRANSPARENT         :: TRANSPARENT;
    D3D12_RAYTRACING_OPACITY_MICROMAP_STATE_OPAQUE              :: OPAQUE;
    D3D12_RAYTRACING_OPACITY_MICROMAP_STATE_UNKNOWN_TRANSPARENT :: UNKNOWN_TRANSPARENT;
    D3D12_RAYTRACING_OPACITY_MICROMAP_STATE_UNKNOWN_OPAQUE      :: UNKNOWN_OPAQUE;
}

