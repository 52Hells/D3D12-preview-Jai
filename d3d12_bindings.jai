    OC1_2_STATE :: 1;
    OC1_4_STATE :: 2;

    D3D12_RAYTRACING_OPACITY_MICROMAP_FORMAT_OC1_2_STATE :: OC1_2_STATE;
    D3D12_RAYTRACING_OPACITY_MICROMAP_FORMAT_OC1_4_STATE :: OC1_4_STATE;
